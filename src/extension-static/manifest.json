{
  "manifest_version": 3,
  "name": "Bilimuzhi",
  "short_name": "Bilimuzhi",
  "version": "0.9.0",
  "description": "AI subtitle workspace browser extension for Bilibili videos: subtitle timeline, session workspace, segments, summaries, chat, and batch processing.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/muzhi-16.png",
    "32": "icons/muzhi-32.png",
    "48": "icons/muzhi-48.png",
    "128": "icons/muzhi-128.png"
  },
  "action": {
    "default_title": "Open Bilimuzhi",
    "default_icon": {
      "16": "icons/muzhi-16.png",
      "32": "icons/muzhi-32.png",
      "48": "icons/muzhi-48.png",
      "128": "icons/muzhi-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "downloads",
    "offscreen",
    "scripting",
    "tabs",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "https://*.hdslb.com/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://api-inference.modelscope.cn/*",
    "https://api.moonshot.cn/*",
    "https://api.openai.com/*",
    "https://api.xiaomimimo.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:11434/*",
    "https://open.bigmodel.cn/*",
    "https://openrouter.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}